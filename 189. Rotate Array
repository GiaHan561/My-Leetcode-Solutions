class Solution:
    def reverse(self, nums, left, right):
        while(left<right):
            nums[left], nums[right] = nums[right], nums[left]
            left +=1
            right -=1

    def rotate(self, nums: list[int], k: int) -> None:
        n = len(nums)

        k = k%n
        left = 0
        right = n -1
        self.reverse(nums,left, right)
        self.reverse(nums,0, k-1)
        self.reverse(nums,k, n-1)

        return nums
