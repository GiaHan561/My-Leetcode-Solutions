class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        substring = set()
        max_len = 0
        left = 0
        for right in range(len(s)):
            char = s[right]
            while s[right] in substring:
                substring.remove(s[left])
                left+=1

            substring.add(s[right])
            max_len = max(max_len, right - left + 1)

        return max_len
