class Solution:
    def maxArea(self, height: List[int]) -> int:
        
        left = 0
        right = len(height) - 1

        max_s = 0
        while(left < right):
            s = min(height[left], height[right]) * (right - left)
            max_s = max(max_s,s)
            if height[left] < height[right]:
                left+=1

            elif height[right] < height[left]:
                right-=1

            else:
                left+=1
        
        return max_s
