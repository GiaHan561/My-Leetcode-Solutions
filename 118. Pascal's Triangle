class Solution:
    def generate(self, numRows: int) -> List[List[int]]:
        triangle = []

        for i in range(numRows):
            if i == 0:
                row = [1]

            else:
                row = [1]
                previous = triangle[i-1]
                for j in range(len(previous)-1):
                    row.append(previous[j]+previous[j+1])

                row.append(1)

            triangle.append(row)

        return triangle
